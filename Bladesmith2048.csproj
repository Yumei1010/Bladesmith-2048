<Project Sdk="Godot.NET.Sdk/4.7.2">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RootNamespace>Bladesmith2048</RootNamespace>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <NoWarn>CS0628;CS8785;CS8601;CS8602;CS0169;MA0011;MA0016</NoWarn>
        <!-- 配置 schema 目录（默认 schemas；本项目统一放到 resource/ 下） -->
        <GFrameworkConfigSchemaDirectory>resource/schemas</GFrameworkConfigSchemaDirectory>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="script_templates\**" />
        <Compile Remove="scenes\**" />
        <Compile Remove="tests\**" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Remove="script_templates\**" />
        <EmbeddedResource Remove="scenes\**" />
        <EmbeddedResource Remove="tests\**" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Update="Meziantou.Analyzer" Version="2.0.298">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Update="Meziantou.Polyfill" Version="1.0.104">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="GeWuYou.GFramework" Version="0.7.1" />
        <PackageReference Include="GeWuYou.GFramework.Godot" Version="0.7.1" />
        <PackageReference Include="GeWuYou.GFramework.Godot.SourceGenerators" Version="0.7.1" />
        <PackageReference Include="GeWuYou.GFramework.Core.SourceGenerators" Version="0.7.1" />
        <PackageReference Include="GeWuYou.GFramework.Ecs.Arch" Version="0.7.1" />
        <PackageReference Include="GeWuYou.GFramework.Game.SourceGenerators" Version="0.7.1" />
        <PackageReference Include="GeWuYou.GFramework.Cqrs.SourceGenerators" Version="0.7.1" />
    </ItemGroup>
    <ItemGroup>
        <Content Include=".github\workflows\auto-tag.yml" />
        <Content Include=".github\workflows\ci.yml" />
        <Content Include=".github\workflows\codeql.yml" />
        <Content Include=".github\workflows\release.yml" />
        <Content Include="addons.jsonc" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Bladesmith2048.Tests" />
    </ItemGroup>
</Project>
